{
  "name": "crz-expectations",
  "dockerComposeFile": "../compose.yaml",
  "service": "spark",
  "runServices": ["spark"],
  "workspaceFolder": "/app",
  "overrideCommand": true,
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.testing.pytestEnabled": true
      }
    }
  }
}